# Copy to .env and fill in. The .env file is gitignored.
# electron-vite exposes MAIN_VITE_* variables to the main process via import.meta.env.

# Groq API key used by the AI features (https://console.groq.com/keys)
# Only needed when calling Groq directly (no proxy). Leave empty in distributed
# builds — the proxy below holds the key server-side instead.
MAIN_VITE_GROQ_API_KEY=

# Managed AI proxy (ai-proxy/). When set, AI calls route through the Worker so
# the Groq key never ships in the app. URL ends in /v1; token is minted via
# POST <proxy>/register.
MAIN_VITE_AI_PROXY_URL=
MAIN_VITE_AI_PROXY_TOKEN=
